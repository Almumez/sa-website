# Local persistent data directory. Relative paths resolve from the project root.
PORTAL_DATA_DIR=./data

# Public HTTPS origin when deployed behind a reverse proxy. Leave blank locally.
APP_ORIGIN=

# Enable only when your trusted proxy overwrites X-Forwarded-For.
TRUST_PROXY=false

# Only for first administrator setup in a NEW empty store.
# Migrated accounts keep their existing passwords and need no setup.
ADMIN_SETUP_SECRET=
SITE_OWNER_EMAIL=
PORTAL_OWNER_DATA_ID=portal-owner
