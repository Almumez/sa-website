# Turso: use a separate database for Preview deployments.
TURSO_DATABASE_URL=libsql://YOUR-DATABASE.turso.io
TURSO_AUTH_TOKEN=

# Private S3-compatible bucket. For R2 use the account's S3 endpoint.
S3_ENDPOINT=https://YOUR-ACCOUNT-ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Generate two different secrets: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SETUP_SECRET=
UPLOAD_SIGNING_SECRET=
SITE_OWNER_EMAIL=
# When migrating existing data, use the existing documents.owner value.
PORTAL_OWNER_DATA_ID=portal-owner
