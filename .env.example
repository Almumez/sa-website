# Local persistent data directory. Relative paths resolve from the project root.
PORTAL_DATA_DIR=./data

# Public HTTPS origin when deployed behind a reverse proxy. Leave blank locally.
APP_ORIGIN=

# Enable only when your trusted proxy overwrites X-Forwarded-For.
TRUST_PROXY=false

# Only for first administrator setup in a NEW empty store.
# Migrated accounts keep their existing passwords and need no setup.
ADMIN_SETUP_SECRET=
SESSION_SIGNING_SECRET=
SITE_OWNER_EMAIL=
PORTAL_OWNER_DATA_ID=portal-owner

# On Vercel, connect a private Blob store in Project > Storage.
# This token is required by authenticated direct uploads larger than 4.5 MB.
BLOB_READ_WRITE_TOKEN=

# Optional file storage on Cloudflare R2. When all four are set, new files
# are stored in R2; existing Vercel Blob files remain readable during migration.
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
